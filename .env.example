# BreakLoop Environment Configuration
#
# IMPORTANT: This file contains NO credentials or secrets.
# All sensitive credentials are configured via UI on first setup.
#
# See ZERO_HARDCODED_CREDENTIALS.md for detailed explanation.

# ─── REQUIRED ────────────────────────────────────────────────────────────

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (Required for bootstrap - the ONLY env var with credentials)
# Change credentials for production
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/breakloop

# ─── OPTIONAL ────────────────────────────────────────────────────────────
#
# Leave these blank - they will be generated via UI setup wizard
# OR set them if you want to skip the setup wizard (not recommended)

# JWT Secret (auto-generated on setup, 32+ chars)
# Leave blank to generate automatically
# JWT_SECRET=

# Encryption Key (auto-generated on setup, 64 hex chars)
# Leave blank to generate automatically
# ENCRYPTION_KEY=

# ─── OPTIONAL EXTERNAL SERVICES ──────────────────────────────────────────

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# OpenAI API (for OpenAI evaluator or agent adapter)
# Leave blank to use UI configuration
# OPENAI_API_KEY=sk-...

# Anthropic API (for Claude adapter or Mock adapter)
# Leave blank to use UI configuration
# ANTHROPIC_API_KEY=sk-ant-...

# ─── EVALUATOR CONFIGURATION ─────────────────────────────────────────────

EVALUATOR_MODEL=gpt-4o-mini
EVALUATOR_MAX_TOKENS=1024

# ─── FRONTEND CONFIGURATION ──────────────────────────────────────────────

VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# ─── NOTES ───────────────────────────────────────────────────────────────
#
# First Time Setup:
#   1. Keep only: PORT, NODE_ENV, DATABASE_URL
#   2. Start the app
#   3. Visit http://localhost:5173
#   4. Complete setup wizard
#   5. JWT secret and encryption key generated automatically
#
# For Production:
#   1. Update DATABASE_URL with production credentials
#   2. Do NOT add JWT_SECRET or ENCRYPTION_KEY to .env
#   3. Complete setup via UI (will generate unique secrets)
#   4. Consider using secret management (Vault, AWS Secrets Manager)
#
# For Agent Credentials:
#   - Configure via BreakLoop UI (Agents → Onboard)
#   - Stored encrypted in database
#   - NOT in .env files
#
# For Evaluator API Keys:
#   - Configure via BreakLoop UI (Settings → Evaluator LLM)
#   - Stored encrypted in database
#   - NOT in .env files
